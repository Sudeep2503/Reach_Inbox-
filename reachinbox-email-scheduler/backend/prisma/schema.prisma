generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  PARTIALLY_FAILED
  FAILED
  CANCELLED
}

enum EmailJobStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  googleId  String?  @unique
  email     String   @unique
  name      String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senders   Sender[]
  campaigns Campaign[]
  sessions  Session[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  sessionToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Sender {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  email        String
  displayName  String
  smtpHost     String
  smtpPort     Int
  smtpUser     String
  smtpPassword String
  hourlyLimit  Int      @default(200)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailJobs EmailJob[]

  @@unique([userId, email])
  @@index([userId])
  @@index([email])
  @@map("senders")
}

model Campaign {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  subject          String
  body             String
  startTime        DateTime
  delayMs          Int
  hourlyLimit      Int            @default(200)
  status           CampaignStatus @default(DRAFT)
  totalRecipients  Int            @default(0)
  scheduledCount   Int            @default(0)
  sentCount        Int            @default(0)
  failedCount      Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailJobs EmailJob[]

  @@index([userId])
  @@index([startTime])
  @@index([status])
  @@map("campaigns")
}

model EmailJob {
  id            String         @id @default(uuid()) @db.Uuid
  campaignId    String         @db.Uuid
  senderId      String         @db.Uuid
  recipient     String
  subject       String
  body          String
  scheduledAt   DateTime
  status        EmailJobStatus @default(SCHEDULED)
  attempts      Int            @default(0)
  sentAt        DateTime?
  failedAt      DateTime?
  lastAttemptAt DateTime?
  errorCode     String?
  errorMessage  String?
  bullJobId     String?        @unique
  previewUrl    String?
  scheduleVersion      Int            @default(1)
  nextAttemptAt        DateTime?
  rateLimitReschedules Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender   Sender   @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([senderId])
  @@index([recipient])
  @@index([scheduledAt])
  @@index([status])
  @@index([status, scheduledAt])
  @@index([campaignId, status])
  @@map("email_jobs")
}
