PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

FRONTEND_URL=http://localhost:5173

SESSION_SECRET=
SESSION_COOKIE_NAME=reachinbox_session
SESSION_TTL_DAYS=7
SESSION_COOKIE_SAME_SITE=lax

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

WORKER_CONCURRENCY=5
MAX_EMAILS_PER_HOUR=200
MIN_DELAY_BETWEEN_EMAILS=2000

MAX_UPLOAD_SIZE_MB=5
BATCH_INSERT_SIZE=500
MAX_CAMPAIGN_DELAY_MS=3600000
MAX_CAMPAIGN_HOURLY_LIMIT=10000

BULLMQ_QUEUE_NAME=email-sending
QUEUE_REMOVE_ON_COMPLETE=1000
QUEUE_REMOVE_ON_FAIL=5000
BULLMQ_JOB_ATTEMPTS=3
BULLMQ_BACKOFF_DELAY=5000

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=ReachInbox Scheduler
EMAIL_FROM_ADDRESS=

MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MIN_DELAY_BETWEEN_EMAILS=2000
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_SAFETY_BUFFER_MS=100
RATE_LIMIT_KEY_PREFIX=reachinbox:rate
THROTTLE_KEY_PREFIX=reachinbox:throttle
